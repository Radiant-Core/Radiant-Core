# Radiant Core - Linux x64 Build
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    git \
    libboost-all-dev \
    libevent-dev \
    libssl-dev \
    libdb++-dev \
    libminiupnpc-dev \
    libzmq3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/radiant
COPY . .

RUN cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_RADIANT_WALLET=OFF \
    -DBUILD_RADIANT_DAEMON=ON \
    -DBUILD_RADIANT_CLI=ON \
    -DBUILD_RADIANT_TX=ON \
    -DBUILD_RADIANT_QT=OFF \
    -DENABLE_HARDENING=ON

RUN cmake --build build --target radiantd radiant-cli radiant-tx -j$(nproc)

RUN mkdir -p /release/radiant-core-linux-x64 && \
    cp build/src/radiantd /release/radiant-core-linux-x64/ && \
    cp build/src/radiant-cli /release/radiant-core-linux-x64/ && \
    cp build/src/radiant-tx /release/radiant-core-linux-x64/ && \
    strip /release/radiant-core-linux-x64/*

WORKDIR /release
RUN tar -czf radiant-core-linux-x64-v3.0.0.tar.gz radiant-core-linux-x64

CMD ["/bin/bash"]
