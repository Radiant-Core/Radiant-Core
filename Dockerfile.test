# Radiant Node - Test build with verificationprogress fix
# ============================================================================
# DEVELOPMENT/TESTING ONLY - Builds from LOCAL source code
# ============================================================================
# This Dockerfile is intended for local development and testing with 
# uncommitted changes or patches. It copies the local source tree.
#
# For production builds, use: docker/Dockerfile.release
# ============================================================================

# SECURITY (audit N4): pin the base image by immutable digest, not the mutable
# `ubuntu:22.04` tag. PIN-REQUIRED: replace the placeholder with the digest
# from `docker pull ubuntu:22.04 && docker inspect \
#   --format='{{index .RepoDigests 0}}' ubuntu:22.04`. The tag is kept for
# human readability only.
FROM ubuntu:22.04@sha256:PINNED_DIGEST_PLACEHOLDER

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    libtool \
    autotools-dev \
    automake \
    pkg-config \
    libssl-dev \
    libevent-dev \
    bsdmainutils \
    libboost-all-dev \
    libzmq3-dev \
    libminiupnpc-dev \
    cmake \
    ninja-build \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/radiant

# Copy local source with fixes (DEVELOPMENT ONLY)
COPY . .

# Build radiantd
RUN cmake -B build -G Ninja \
    -DBUILD_RADIANT_QT=OFF \
    -DBUILD_RADIANT_WALLET=OFF \
    -DENABLE_MAN=OFF \
    -DCMAKE_BUILD_TYPE=Release

RUN cmake --build build --target radiantd radiant-cli -j$(nproc)

RUN install -m 755 build/src/radiantd /usr/local/bin/ && \
    install -m 755 build/src/radiant-cli /usr/local/bin/

RUN mkdir -p /root/.radiant

EXPOSE 7332 7333

VOLUME ["/root/.radiant"]

ENTRYPOINT ["radiantd"]
CMD ["-server=1", "-printtoconsole"]
